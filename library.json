{
    "name": "TRT-Astra-Rocket",
    "version": "0.2.0",
    "description": "Terrapin Rocket Team's Multi-Mission Flight Software. Redefines Astra to be specific to our rockets",
    "keywords": "Astra, TRT, Terrapin Rocket Team, Flight Software",
    "repository": 
    {
        "type": "git",
        "url": "https://github.com/Terrapin-Rocket-Team/Astra-Rocket.git"
    },
    "authors": 
    [
        {
            "name": "Drew Brandt",
            "url": "https://github.com/DrewBrandt"
        },
        {
            "name": "Terrapin Rocket Team",
            "url": "https://github.com/Terrapin-Rocket-Team"
        }
    ],
    "license": "MIT",
    "homepage": "https://github.com/Terrapin-Rocket-Team/Astra-Rocket",
    "dependencies": 
    [
        
        {
            "name": "Astra",
            "version": "https://github.com/Terrapin-Rocket-Team/Astra.git#cleanup-ai-slop"
        },
        {
            "name": "arc_protocol",
            "version": "https://github.com/DrewBrandt/arc-protocol.git"
        }
    ],
    "frameworks": "*",
    "platforms": [
        "teensy",
        "native",
        "ststm32",
        "espressif32"
    ],
    "build":
    {
        "libLDFMode": "deep+",
        "libCompatMode": "strict",
        "srcFilter":
        [
            "+<*>"
        ],
        "flags": "-Wno-unknown-pragmas",
        "extraScript": "get_version.py",
        "unflags": "-std=gnu++11",
        "platforms": {
            "native": {
                "flags": [
                    "-std=c++17",
                    "-DNATIVE=1"
                ]
            },
            "teensy": {
                "flags": [
                    "-std=c++17",
                    "-D ENV_TEENSY"
                ]
            }
        }
    }
}
